{
  "name": "forum_client",
  "homepage": "https://ensil-dev.github.io/DogGain_Forum/",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "start": "vite --host",
    "build": "vite build",
    "postbuild": "cp -f dist/index.html dist/404.html && npx shx touch dist/.nojekyll",
    "preview": "vite preview",
    "predeploy": "npm run build && npm run postbuild",
    "deploy": "gh-pages -d dist -b gh-pages --dotfiles",
    "docker:build": "cd .. && ./docker-build.sh",
    "docker:start": "cd .. && ./docker-run.sh",
    "docker:stop": "docker stop doggain-forum",
    "docker:test": "npm run docker:build && npm run docker:start"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chart.js": "^4.4.9",
    "dotenv": "^16.4.5",
    "firebase": "^10.13.1",
    "gh-pages": "^6.1.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-query": "^3.39.3",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.0",
    "react-share": "^4.4.1",
    "react-toastify": "^11.0.5",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.1.12",
    "swr": "^2.2.5",
    "vite": "^5.4.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^19.1.6",
    "shx": "^0.3.4",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
