# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*


gitignore# 환경 변수 파일들
.env
.env.local
.env.development.local
.env.test.local  
.env.production.local

# 설정 파일들
config/secrets.yml
config/database.yml
config/credentials.yml.enc (Rails의 경우 master key만 제외)

# API 키가 포함될 수 있는 파일들
secrets.json
credentials.json
service-account-key.json

# IDE 설정 파일들 (API 키가 저장될 수 있음)
.vscode/settings.json
.idea/
*.swp
*.swo

# 로그 파일들
*.log
logs/